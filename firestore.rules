rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signed() { return request.auth != null && request.auth.token.email != null; }
    function member() { return get(/databases/$(database)/documents/members/$(email())).data; }
    function isMember() { return signed() && exists(/databases/$(database)/documents/members/$(email())); }
    function isAdmin() { return isMember() && member().func == 'Administrador'; }
    function isStaff() { return isMember() && (member().role == 'Comissão' || member().func == 'Administrador'); }
    function isGuest() { return isMember() && member().role == 'Convidado'; }
    function isBootstrap() { return signed() && email() == 'rennato158@gmail.com'; }
    function ownFlagOnly() { return signed() && resource.id == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']); }
    match /members/{id} {
      allow read: if isMember() || (isBootstrap() && id == email());
      allow create: if isAdmin() || (isBootstrap() && id == email());
      allow update: if isAdmin() || ownFlagOnly();
      allow delete: if isAdmin();
    }
    match /groups/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isMember() && resource.data.to == email();
      allow create: if isStaff();
      allow update: if isMember() && resource.data.to == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isMember() && resource.data.to == email());
    }
    match /competitions/{id} {
      allow read: if isStaff() || (isGuest() && id in member().get('comps', []));
      allow write: if isAdmin();
    }
    match /teams/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if isStaff() || (isGuest() && resource.data.compId in member().get('comps', []));
      allow create, delete: if isAdmin();
      allow update: if isStaff();
    }
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }
    match /playlists/{id} {
      allow read: if isStaff() || (isMember() && email() in resource.data.get('shareMembers', []));
      allow create, update, delete: if isStaff();
    }
    match /videos/{id} {
      allow read: if isStaff() || (isMember() && email() in resource.data.viewers);
      allow create, delete: if isAdmin();
      allow update: if isStaff();
    }
  }
}
